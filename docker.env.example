# Docker Hub settings for build-images.sh. Copy to docker.env and fill in.
# docker.env is git-ignored; never commit real credentials.

# Docker Hub account used to log in
DOCKERHUB_USERNAME=your-dockerhub-user
# Personal access token (Docker Hub > Account settings > Personal access tokens),
# with Read & Write scope. A token is preferred over your password.
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx
# Repository namespace (user or organisation). Defaults to DOCKERHUB_USERNAME.
DOCKERHUB_NAMESPACE=
# Platforms built when pushing (comma separated), e.g. linux/amd64,linux/arm64
DOCKER_PLATFORMS=linux/amd64
