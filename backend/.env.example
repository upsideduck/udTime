# SQLAlchemy URL to the existing udTime MySQL/MariaDB database
UDTIME2_DATABASE_URL=mysql+pymysql://udtime:secret@localhost:3306/udTime
# Random secret (min 16 chars) used to sign login tokens
UDTIME2_JWT_SECRET=
# How long a login token is valid, in minutes
UDTIME2_JWT_EXPIRE_MINUTES=720
# Random secret (min 16 chars) shared with the frontend
UDTIME2_FRONTEND_SERVICE_SECRET=
# Allow anyone to register a new account via POST /api/v1/users
UDTIME2_ALLOW_REGISTRATION=false
# Set to true if the database still has the BEFORE DELETE triggers filling `deleted`
UDTIME2_DB_HAS_DELETE_TRIGGERS=false
# Used when a user has no valid timezone stored
UDTIME2_DEFAULT_TIMEZONE=Europe/Stockholm
# Interactive API docs at /docs (disable in production unless needed)
UDTIME2_API_DOCS=true
