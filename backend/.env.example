# SQLAlchemy URL to the existing udTime MySQL/MariaDB database
DATABASE_URL=mysql+pymysql://udtime:secret@localhost:3306/udTime
# Secret used to sign login tokens
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080
# Shared secret the frontend uses for Authentik (trusted header) logins
FRONTEND_SERVICE_SECRET=change-me-too
# Allow anyone to register a new account via POST /api/v1/users
ALLOW_REGISTRATION=false
# Set to true if the database still has the BEFORE DELETE triggers filling `deleted`
DB_HAS_DELETE_TRIGGERS=false
# Used when a user has no valid timezone stored
DEFAULT_TIMEZONE=Europe/Stockholm
