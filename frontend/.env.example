# Base URL of the udTime backend
BACKEND_URL=http://localhost:8000
# Random secret (min 16 chars) used to sign the session cookie
SESSION_SECRET=
# true when served over https (production); false for local http testing
SESSION_HTTPS_ONLY=false
# How long a sign-in lasts, in seconds
SESSION_MAX_AGE=43200
# Must equal the backend FRONTEND_SERVICE_SECRET (min 16 chars)
FRONTEND_SERVICE_SECRET=
DEFAULT_TIMEZONE=Europe/Stockholm

# --- Single sign-on with OpenID Connect (Authentik "udauth"); leave OIDC_ISSUER empty to disable
# Issuer URL from the Authentik provider, e.g. https://auth.example.com/application/o/udtime/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to <this site>/sso/callback; set it if the app is behind a proxy that hides the public URL
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Claim that holds the udTime username
OIDC_USERNAME_CLAIM=preferred_username
# Text on the "Sign in with ..." button
SSO_LABEL=udauth
