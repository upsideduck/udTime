# Base URL of the udTime backend
UDTIME2_BACKEND_URL=http://localhost:8000
# Random secret (min 16 chars) used to sign the session cookie
UDTIME2_SESSION_SECRET=
# true when served over https (production); false for local http testing
UDTIME2_SESSION_HTTPS_ONLY=false
# How long a sign-in lasts, in seconds
UDTIME2_SESSION_MAX_AGE=43200
# Must equal the backend UDTIME2_FRONTEND_SERVICE_SECRET (min 16 chars)
UDTIME2_FRONTEND_SERVICE_SECRET=
UDTIME2_DEFAULT_TIMEZONE=Europe/Stockholm

# --- Single sign-on with OpenID Connect (Authentik "udauth")
# true shows "Sign in with ..." on the login page; then UDTIME2_OIDC_ISSUER and UDTIME2_OIDC_CLIENT_ID are required
UDTIME2_OIDC_ENABLED=false
# Issuer URL from the Authentik provider, e.g. https://auth.example.com/application/o/udtime/
UDTIME2_OIDC_ISSUER=
UDTIME2_OIDC_CLIENT_ID=
UDTIME2_OIDC_CLIENT_SECRET=
# Defaults to <this site>/sso/callback; set it if the app is behind a proxy that hides the public URL
UDTIME2_OIDC_REDIRECT_URI=
UDTIME2_OIDC_SCOPES=openid profile email
# Claim that holds the udTime username
UDTIME2_OIDC_USERNAME_CLAIM=preferred_username
# Text on the "Sign in with ..." button
UDTIME2_SSO_LABEL=udauth
