# Base URL of the udTime backend
BACKEND_URL=http://localhost:8000
# Secret used to sign the session cookie
SESSION_SECRET=change-me
# Set to true when served over https
SESSION_HTTPS_ONLY=false
# Must equal the backend FRONTEND_SERVICE_SECRET (used for Authentik logins)
FRONTEND_SERVICE_SECRET=change-me-too
# Trust the X-Authentik-Username header set by the reverse proxy.
# Only enable when the proxy strips this header from client requests!
TRUST_AUTHENTIK_HEADER=false
AUTHENTIK_HEADER=X-Authentik-Username
AUTHENTIK_LOGOUT_URL=/outpost.goauthentik.io/sign_out
# Name shown on the "Sign in with ..." button on the login page (shown when TRUST_AUTHENTIK_HEADER=true)
SSO_LABEL=udauth
# Default timezone offered on the registration form
DEFAULT_TIMEZONE=Europe/Stockholm
