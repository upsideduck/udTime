# Settings for docker-compose.yml. Copy to .env (git-ignored) and fill in.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Images -----------------------------------------------------------------------------
# Docker Hub namespace incl. trailing slash (e.g. johan/), empty for locally built images
UDTIME_IMAGE_PREFIX=
# Image tag to run: latest or a build timestamp such as 20261107_122116
UDTIME_TAG=latest

# --- Frontend port on the host (Nginx Proxy Manager proxies to this) ----------------------
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8001

# --- Backend ----------------------------------------------------------------------------
# Your existing database, or the bundled one: mysql+pymysql://udtime:<MARIADB_PASSWORD>@db:3306/udTime
DATABASE_URL=mysql+pymysql://udtime:secret@192.168.1.10:3306/udTime
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
ALLOW_REGISTRATION=false
DB_HAS_DELETE_TRIGGERS=false
DEFAULT_TIMEZONE=Europe/Stockholm

# --- Shared between backend and frontend ------------------------------------------------
FRONTEND_SERVICE_SECRET=

# --- Frontend ---------------------------------------------------------------------------
SESSION_SECRET=
# true when served via https (the proxy); false to test over plain http
SESSION_HTTPS_ONLY=true
# SSO via Authentik (see docs/authentik-nginx-proxy-manager.md)
TRUST_AUTHENTIK_HEADER=false
AUTHENTIK_HEADER=X-Authentik-Username
AUTHENTIK_LOGOUT_URL=/outpost.goauthentik.io/sign_out
SSO_LABEL=udauth
# Proxy addresses allowed to set X-Forwarded-* headers
FORWARDED_ALLOW_IPS=*

# --- Bundled MariaDB (only with `docker compose --profile db up`) -----------------------
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
